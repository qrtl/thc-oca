<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_field_float_decimal_tree" model="ir.ui.view">
        <field name="name">field.float.decimal.tree</field>
        <field name="model">field.float.decimal</field>
        <field name="type">tree</field>
        <field name="arch" type="xml">
            <tree create="1" editable="bottom">
                <field name="res_model_id" />
                <field
                    name="field_id"
                    attrs="{'readonly':[('res_model_id','=',False)]}"
                />
                <field
                    name="company_id"
                    groups="base.group_multi_company"
                    optional="show"
                />
                <field name="digits" />
            </tree>
        </field>
    </record>
    <record id="view_field_float_decimal_searh" model="ir.ui.view">
        <field name="name">field.float.decimal.search</field>
        <field name="model">field.float.decimal</field>
        <field name="arch" type="xml">
            <search string="Field Float Decimal Search">
                <field name="res_model_id" />
                <field name="field_id" />
                <separator />
                <group expand="1" string="Group By">
                    <filter
                        string="Model"
                        name="res_model_id"
                        context="{'group_by': 'res_model_id'}"
                    />
                </group>
            </search>
        </field>
    </record>
    <record id="action_field_float_decimal_view" model="ir.actions.act_window">
        <field name="name">Field Float Decimal</field>
        <field name="res_model">field.float.decimal</field>
        <field name="view_mode">tree</field>
        <field name="view_id" ref="view_field_float_decimal_tree" />
    </record>
    <menuitem
        id="menu_field_float_decimal"
        parent="base.next_id_2"
        action="action_field_float_decimal_view"
        sequence="10"
    />
</odoo>
